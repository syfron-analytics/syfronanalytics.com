---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Syfron Analytics — Data Science, IA y consultoría estadística." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-dark-950 text-dark-200 font-sans antialiased min-h-screen flex flex-col">
    <div class="bg-layer bg-grid" aria-hidden="true"></div>
    <div class="bg-layer bg-grid-glow" aria-hidden="true"></div>
    <div class="bg-layer bg-grain" aria-hidden="true"></div>
    <slot />
    <!-- Scroll animations -->
    <script is:inline>
      (function() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        function observe() {
          document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
        }
        document.addEventListener('astro:page-load', observe);
      })();
    </script>

    <!-- Counter animation -->
    <script is:inline>
      (function() {
        function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

        function animateCounter(el) {
          var target = parseInt(el.getAttribute('data-count-to'), 10);
          var suffix = el.getAttribute('data-count-suffix') || '';
          var duration = 2000;
          var start = performance.now();
          function tick(now) {
            var t = Math.min((now - start) / duration, 1);
            var val = Math.round(easeOut(t) * target);
            var locale = document.documentElement.lang === 'en' ? 'en-US' : 'es-ES';
            el.textContent = val.toLocaleString(locale) + suffix;
            if (t < 1) requestAnimationFrame(tick);
            else el.setAttribute('data-counted', '');
          }
          requestAnimationFrame(tick);
        }

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              animateCounter(e.target);
              observer.unobserve(e.target);
            }
          });
        }, { threshold: 0.5 });

        function init() {
          document.querySelectorAll('[data-count-to]').forEach(function(el) {
            observer.observe(el);
          });
        }
        document.addEventListener('astro:page-load', init);
      })();
    </script>

    <!-- i18n Script -->
    <script is:inline>
      const TRANSLATIONS_KEY = '__syfron_translations';
      
      function getNestedValue(obj, path) {
        return path.split('.').reduce((o, k) => o && o[k], obj);
      }

      function getLang() {
        return localStorage.getItem('syfron-lang') || (navigator.language.startsWith('es') ? 'es' : 'en');
      }

      function setLang(lang) {
        localStorage.setItem('syfron-lang', lang);
        applyLang(lang);
      }

      function applyLang(lang) {
        const t = window[TRANSLATIONS_KEY];
        if (!t) return;
        const strings = t[lang];

        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          const value = getNestedValue(strings, key);
          if (value && typeof value === 'string') {
            // Check if element has child elements to preserve (svg, span icons)
            const hasChildElements = el.querySelector('svg, img');
            if (hasChildElements) {
              // Replace only text nodes
              Array.from(el.childNodes).forEach(n => {
                if (n.nodeType === 3 && n.textContent.trim()) n.textContent = value;
              });
            } else {
              el.textContent = value;
            }
          }
        });

        // Update list items
        document.querySelectorAll('[data-i18n-list]').forEach(el => {
          const key = el.getAttribute('data-i18n-list');
          const items = getNestedValue(strings, key);
          if (Array.isArray(items)) {
            el.innerHTML = items.map(item => 
              `<li class="text-sm text-dark-400 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>${item}</li>`
            ).join('');
          }
        });

        // Update stats
        const stats = getNestedValue(strings, 'portfolio.case.stats');
        if (stats) {
          document.querySelectorAll('[data-i18n-stat]').forEach(el => {
            const attr = el.getAttribute('data-i18n-stat');
            const [idx, field] = attr.split('-');
            const stat = stats[parseInt(idx)];
            if (stat) {
              if (field === 'value') el.textContent = stat.value;
              else if (field === 'label') el.textContent = stat.label;
            }
          });
        }

        // Re-format finished counters for the new locale
        document.querySelectorAll('[data-count-to][data-counted]').forEach(el => {
          const n = parseInt(el.getAttribute('data-count-to'), 10);
          el.textContent = n.toLocaleString(lang === 'en' ? 'en-US' : 'es-ES') + (el.getAttribute('data-count-suffix') || '');
        });

        // Update toggle buttons
        document.querySelectorAll('.lang-toggle').forEach(btn => {
          btn.textContent = lang === 'es' ? 'EN' : 'ES';
        });
        document.documentElement.lang = lang;
        document.dispatchEvent(new CustomEvent('syfron:lang', { detail: lang }));
      }

      // Init on page load and View Transitions
      document.addEventListener('astro:page-load', () => {
        const lang = getLang();
        applyLang(lang);

        document.querySelectorAll('.lang-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const current = getLang();
            setLang(current === 'es' ? 'en' : 'es');
          });
        });

        // Mobile menu
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
          });
        }
      });
    </script>
    <script>
      import '../scripts/effects';
    </script>
    <script is:inline>
      window.__syfronBooted = true;
    </script>
  </body>
</html>
