---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import { translations } from '../i18n/translations';

const about = translations.es.about;

// Founder photo: put the image in public/ and set its path here (e.g. '/fundador.jpg').
// While it is null, the portrait shows a monogram instead.
const founderPhoto: string | null = '/fundador.jpg';
const founderName = 'Enrique Rodríguez Sebastián, PhD';
---

<Layout title="Nosotros — Syfron Analytics">
  <Navbar />

  <section class="relative overflow-clip pt-32 pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Aurora accent -->
      <div class="absolute top-20 right-0 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl -z-10"></div>
      <div class="absolute top-40 left-0 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl -z-10"></div>

      <span class="inline-block text-xs font-mono text-purple-400 bg-purple-500/10 px-3 py-1 rounded-full mb-6 uppercase tracking-wider" data-i18n="nav.about">Nosotros</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-12" data-i18n="about.title" data-animate>{about.title}</h1>

      <div class="grid lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] gap-12 lg:gap-16 items-start">
        <!-- Founder -->
        <aside class="lg:sticky lg:top-28" data-animate>
          <div class="spotlight rounded-2xl border border-dark-800 bg-dark-900/50 p-8 text-center">
            <div class="relative w-40 md:w-48 mx-auto aspect-[866/1000] mb-8">
              <svg class="spin-slow absolute left-1/2 top-1/2 w-[135%] h-[135%] -translate-x-1/2 -translate-y-1/2" viewBox="-50 -50 100 100" fill="none" aria-hidden="true">
                <circle r="47" stroke="#262626" stroke-width="0.6" stroke-dasharray="0.5 3" stroke-linecap="round" />
                <circle cx="0" cy="-47" r="1.6" fill="#34d399" />
                <circle cx="40.7" cy="23.5" r="1.3" fill="#a78bfa" />
              </svg>
              <div class="founder-hex absolute inset-0 bg-gradient-to-br from-emerald-500/60 to-purple-500/60 p-[2px]">
                <div class="founder-hex w-full h-full bg-dark-900 overflow-hidden">
                  {founderPhoto ? (
                    <img src={founderPhoto} alt={founderName} class="w-full h-full object-cover" />
                  ) : (
                    <div class="w-full h-full grid place-items-center bg-[radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1.3px)] [background-size:14px_14px]">
                      <span class="text-gradient font-mono italic font-bold text-4xl md:text-5xl" aria-hidden="true">ERS</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
            <p class="text-white font-semibold text-lg">{founderName}</p>
            <p class="text-emerald-400 font-mono text-xs uppercase tracking-wider mt-1" data-i18n="about.founder_role">{about.founder_role}</p>
            <a href="https://linkedin.com/in/enrique-r-sebastian" target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-sm text-dark-400 hover:text-emerald-400 transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </div>
        </aside>

        <div>
          <div class="space-y-8 text-dark-300 text-lg leading-relaxed">
            <p data-i18n="about.p1" data-animate>{about.p1}</p>
            <p data-i18n="about.p2" data-animate>{about.p2}</p>
          </div>

          <!-- Background -->
          <p class="eyebrow mt-20 mb-10" data-animate>
            <span class="eyebrow-line"></span><span data-i18n="about.timeline_title">{about.timeline_title}</span>
          </p>
          <ProcessTimeline
            items={about.timeline.map((step, i) => ({
              key: `about.timeline.${i}.text`,
              text: step.text,
              titleKey: `about.timeline.${i}.title`,
              title: step.title,
            }))}
          />

          <p class="text-dark-300 text-lg leading-relaxed mt-16" data-i18n="about.p3" data-animate>{about.p3}</p>
        </div>
      </div>

      <!-- Closing statement -->
      <figure class="mt-28 max-w-4xl mx-auto text-center" data-animate>
        <svg class="mx-auto mb-6 w-12 h-12 text-emerald-500/30" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/></svg>
        <blockquote class="text-gradient text-2xl md:text-4xl font-semibold leading-snug" data-i18n="about.p4">{about.p4}</blockquote>
      </figure>
    </div>
  </section>

  <Footer />
</Layout>
