---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import { translations } from '../i18n/translations';

const home = translations.es.home;
const homeEn = translations.en.home;
// Each "why" item gets its own small visual: a canvas viz, or the maths ↔ code morph.
const why = [
  { span: 'md:col-span-2', viz: 'signal' },
  { span: '', morph: ['β = (XᵀX)⁻¹Xᵀy', 'beta = solve(X.T @ X, X.T @ y)'] },
  { span: '', viz: 'order' },
  { span: 'md:col-span-2', viz: 'lattice' },
];
const services = [
  { key: 'stat', viz: 'regression' },
  { key: 'ai', viz: 'rag' },
  { key: 'sci', viz: 'lorenz' },
] as const;
---

<Layout title="Syfron Analytics">
  <Navbar />

  <Hero />

  <!-- What we do -->
  <section class="pt-8 md:pt-12 pb-16 md:pb-20">
    <div class="max-w-4xl mx-auto px-6">
      <p class="eyebrow mb-8" data-animate>
        <span class="eyebrow-num">01</span><span class="eyebrow-line"></span><span data-i18n="home.eyebrows.what">{home.eyebrows.what}</span>
      </p>
      <p
        class="text-2xl md:text-4xl text-dark-200 font-light leading-snug"
        data-i18n="home.whatwedo"
        data-word-reveal
        data-accent-es={home.whatwedo_accent}
        data-accent-en={homeEn.whatwedo_accent}
      >
        {home.whatwedo}
      </p>
    </div>
  </section>

  <!-- Services preview -->
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <p class="eyebrow mb-10" data-animate>
        <span class="eyebrow-num">02</span><span class="eyebrow-line"></span><span data-i18n="home.eyebrows.services">{home.eyebrows.services}</span>
      </p>
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {services.map(({ key, viz }, i) => (
          <div data-animate data-animate-delay={String(i + 1)}>
            <a href="/servicios" class="service-card spotlight group h-full p-6 lg:p-7 rounded-2xl border border-dark-800 bg-dark-900/50 block">
              <div class="h-36 rounded-xl bg-dark-950/70 border border-dark-800/80 mb-6 overflow-hidden">
                <canvas data-viz={viz} class="block w-full h-full" aria-hidden="true"></canvas>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3" data-i18n={`home.services.${key}.title`}>{home.services[key].title}</h3>
              <p class="text-dark-400 text-sm leading-relaxed" data-i18n={`home.services.${key}.desc`}>{home.services[key].desc}</p>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-6">
      <p class="eyebrow mb-6" data-animate>
        <span class="eyebrow-num">03</span><span class="eyebrow-line"></span><span data-i18n="home.eyebrows.how">{home.eyebrows.how}</span>
      </p>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4" data-i18n="home.how.title" data-animate>{home.how.title}</h2>
      <p class="text-dark-400 text-lg mb-14" data-i18n="home.how.intro" data-animate>{home.how.intro}</p>
      <ProcessTimeline items={home.how.items.map((text, i) => ({ key: `home.how.items.${i}`, text }))} />
      <p class="text-gradient text-lg md:text-xl font-medium mt-14 w-fit" data-i18n="home.how.closing" data-animate>{home.how.closing}</p>
    </div>
  </section>

  <!-- Why Syfron -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <p class="eyebrow mb-6" data-animate>
        <span class="eyebrow-num">04</span><span class="eyebrow-line"></span><span data-i18n="home.eyebrows.why">{home.eyebrows.why}</span>
      </p>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-10" data-i18n="home.why.title" data-animate>{home.why.title}</h2>
      <div class="grid md:grid-cols-3 gap-4 md:gap-5">
        {why.map((item, i) => (
          <div class={item.span} data-animate data-animate-delay={String((i % 2) + 1)}>
            <div class="spotlight h-full p-5 md:p-6 rounded-2xl border border-dark-800 bg-dark-900/50 flex flex-col">
              {item.viz ? (
                <div class="h-32 rounded-xl bg-dark-950/70 border border-dark-800/80 mb-5 overflow-hidden">
                  <canvas data-viz={item.viz} class="block w-full h-full" aria-hidden="true"></canvas>
                </div>
              ) : (
                <div class="h-32 rounded-xl bg-dark-950/70 border border-dark-800/80 mb-5 flex flex-col items-center justify-center gap-4 px-3" data-morph={JSON.stringify(item.morph)} aria-hidden="true">
                  <div class="flex gap-2 font-mono text-[10px] uppercase tracking-wider">
                    <span class="px-2 py-0.5 rounded-full border is-active" data-morph-tag>∑ math</span>
                    <span class="px-2 py-0.5 rounded-full border" data-morph-tag>&lt;/&gt; code</span>
                  </div>
                  <code class="font-['JetBrains_Mono',monospace] text-emerald-300 text-sm whitespace-nowrap" data-morph-text>{item.morph?.[0]}</code>
                </div>
              )}
              <p class="text-dark-200 text-base md:text-lg leading-snug" data-i18n={`home.why.items.${i}`}>{home.why.items[i]}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-gradient font-medium text-xl md:text-2xl mt-10 w-fit" data-i18n="home.why.closing" data-animate>{home.why.closing}</p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative overflow-hidden py-28 md:py-40" data-cta>
    <canvas data-cta-canvas class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <p class="text-dark-200 text-xl md:text-2xl font-light mb-10 max-w-2xl mx-auto" data-i18n="home.cta.text" data-animate>{home.cta.text}</p>
      <div data-animate>
        <span class="cta-ring">
          <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-medium transition" data-cta-target>
            <span data-i18n="home.cta.button">{home.cta.button}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </span>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import '../scripts/viz/services';
  import '../scripts/viz/why';
  import '../scripts/word-reveal';
  import '../scripts/cta';
</script>
