---
import LogoMark from './LogoMark.astro';
---

<!-- Intro only on the first page view of a visit (not after in-site navigation) and never with reduced motion. -->
<script is:inline>
  if (!window.__syfronBooted && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('has-intro', 'intro-pending');
  }
</script>

<section class="hero relative min-h-screen flex items-center justify-center overflow-hidden pt-16" data-hero>
  <canvas data-hero-canvas class="hero-canvas absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/3 -right-32 w-80 h-80 bg-purple-500/[0.08] rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-emerald-600/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 text-center">
    <div class="w-fit mx-auto mb-8" transition:name="brand-logo">
      <LogoMark class="hero-logo h-32 md:h-44 w-auto text-white/90" data-hero-logo />
    </div>
    <h1 class="hero-title text-5xl md:text-7xl font-bold italic text-white mb-6 tracking-tight font-mono" aria-label="Syfron Analytics">
      <span data-scramble aria-hidden="true">SYFRON</span><span class="text-emerald-400" data-scramble aria-hidden="true"> ANALYTICS</span>
    </h1>
    <p class="hero-fade text-xl md:text-2xl text-dark-300 mb-4 font-light" style="--d: 0.1s; --d-intro: 1.3s;" data-i18n="hero.tagline">
      De la ciencia a soluciones reales
    </p>
    <p class="hero-fade text-dark-400 max-w-2xl mx-auto mb-12" style="--d: 0.2s; --d-intro: 1.5s;" data-i18n="hero.subtitle">
      Data Science, Inteligencia Artificial y Computación Científica para resolver problemas complejos de negocio
    </p>
    <div class="hero-fade" style="--d: 0.3s; --d-intro: 1.7s;">
      <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-medium transition shadow-lg shadow-emerald-600/20">
        <span data-i18n="hero.cta">Hablemos</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>
